# Alumni Connect — RV University Environment Configuration

# Neon Serverless PostgreSQL Connection URL
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=3000

# Session & Token Secrets
SESSION_SECRET="your-secure-session-secret-change-in-production"

# Application URL
APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
